# DEV ONLY — optional override when Vite and the Go API run on different hosts.
# Unset for normal local dev (serverUrls.ts defaults to ws://localhost:8080/ws).
# Never set this for `make build` / production: the embedded client ignores it and
# always uses same-origin so LAN students dial the instructor host, not localhost.
# VITE_WS_BASE_URL=ws://localhost:8080/ws
