DATABASE_URL=postgres://postgres:postgres@localhost:5432/monopoly?sslmode=disable

# Bind all interfaces so LAN clients can reach the server (default if unset).
# Examples: 0.0.0.0:8080   or   10.10.40.69:8080
LISTEN_ADDR=0.0.0.0:8080
# Alternative to LISTEN_ADDR — only the port, always on 0.0.0.0:
# PORT=8080

ADMIN_TOKEN_TTL=15m
# Required — server refuses to start if empty. Set your own values; there is no default.
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
