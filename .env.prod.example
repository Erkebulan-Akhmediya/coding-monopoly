# Copy to .env.prod and fill in. Use with:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=monopoly
# Must be URL-safe (it is embedded in DATABASE_URL). Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=monopoly

# Required — the server refuses to start if empty.
ADMIN_PASSWORD=
# Generate: openssl rand -hex 32
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL=15m

# Host interface/port the game is published on (students open http://<LAN-IP>:GAME_PORT/).
GAME_BIND_ADDR=0.0.0.0
GAME_PORT=8080
GAME_IMAGE_TAG=latest
